        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bloque B: Flujo CI/CD + IaC -->
        <mxCell id="cicd_group" value="B. Flujo de Despliegue Continuo (CI/CD) e Infraestructura como Código (IaC)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;fillColor=#FAF5FF;strokeColor=#7E22CE;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="980" height="260" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="1. Git Push / Pull Request&#xa;(Código App + Scripts&#xa;Terraform / Bicep)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="490" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="2. Pipeline CI (Azure DevOps)&#xa;Pruebas, escaneo seguridad&#xa;y Docker Build -> Push ACR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="490" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="3. Etapa IaC (Terraform)&#xa;terraform plan &amp; apply&#xa;(Estado remoto en Blob)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="490" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="4. Despliegue CD + Monitoreo&#xa;Rolling Update en AKS/App&#xa;y telemetría en Azure Monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="490" width="190" height="100" as="geometry" />
