  <diagram id="flow-cicd" name="2. Flujo de Datos y Despliegue IaC">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title2" value="Diagrama 2: Flujo de Peticiones (Runtime) y Pipeline de Automatización (IaC + CI/CD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2C59;strokeColor=#0F2C59;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="980" height="50" as="geometry" />
        </mxCell>

        <!-- Bloque A: Flujo de Datos -->
        <mxCell id="runtime_group" value="A. Flujo de Ejecución y Seguridad de Datos en Tiempo Real" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="980" height="260" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="1. Cliente solicita Web&#xa;e Imágenes vía HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="190" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="2. Azure Front Door + WAF&#xa;Filtra ataques y sirve&#xa;imágenes desde Blob CDN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="190" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="3. Frontend (App Service)&#xa;consume APIs del Backend&#xa;(AKS / Container Apps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="190" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="4. Backend autentica con&#xa;Managed Identity y consulta&#xa;BD por Private Endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="190" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
